#include <input/processors.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/input_transform.h>
/ {
    
    zip_threshold_temp_layer: input_processor_threshold_temp_layer {
        compatible = "zmk,input-processor-threshold-temp-layer";
        #input-processor-cells = <2>;
        
        activation-threshold = <100>;
        
        // Ignore residual motion immediately after left-hand typing.
        require-prior-idle-ms = <200>;
        
        // Physical left half. First non-modifier action is swallowed to exit;
        // this includes mouse buttons, scrolling, layer keys and &none.
        typing-positions = <0 1 2 3 4 10 11 12 13 14
                            20 21 22 23 24 25 32 33 34 35 36 37>;
    };

    
    zip_trackball_arrows: zip_trackball_arrows {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        mode = <1>;
        bindings = <&kp RIGHT>,
                   <&kp LEFT>,
                   <&kp UP>,
                   <&kp DOWN>;
        tick = <12>;
        wait-ms = <0>;
        tap-ms = <8>;
        max_pending_activations = <10>;
    };
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_split>;

    
    // Latched until a left-hand non-modifier action; no inactivity timeout.
    input-processors = <&zip_threshold_temp_layer 5 0>;

    
    arrows {
        layers = <2>;
        input-processors = <&zip_trackball_arrows>;
    };

    
    scroller {
        layers = <6>;
        input-processors =
            
            <&zip_xy_to_scroll_mapper>,
            
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
            
            <&zip_scroll_scaler 1 10>;
    };
};
