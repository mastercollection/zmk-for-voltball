if ZMK_POINTING

config ZMK_INPUT_PROCESSOR_THRESHOLD_TEMP_LAYER
    bool "Voltball latched automatic mouse layer"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_THRESHOLD_TEMP_LAYER_ENABLED
    help
      Latch the mouse layer after pointer motion reaches the threshold.
      Requires the pinned ZMK behavior hook installed by patch_auto_mouse.py.
      A non-modifier press on a key that is &trans on the layer exits it and
      is still delivered. Modifier actions keep the layer.

endif # ZMK_POINTING
