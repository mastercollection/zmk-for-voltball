/*
 * SPDX-License-Identifier: MIT
 * TOTEM master b4b2073: 38 keys mapped to Voltball; Totem layer numbering; main mouse/BT/scroll retained.
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <185>;
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&lt { quick-tap-ms = <185>; };

/ {
    combos {
        compatible = "zmk,combos";

        c1 {
            bindings = <&kp LBKT>;
            key-positions = <3 2>;
            timeout-ms = <20>;
        };

        c2 {
            bindings = <&kp RBKT>;
            key-positions = <6 7>;
            timeout-ms = <20>;
        };

        c3 {
            bindings = <&kp LPAR>;
            key-positions = <13 12>;
            timeout-ms = <20>;
        };

        c4 {
            bindings = <&kp RPAR>;
            key-positions = <16 17>;
            timeout-ms = <20>;
        };

        c5 {
            bindings = <&kp LBRC>;
            key-positions = <23 22>;
            timeout-ms = <20>;
        };

        c6 {
            bindings = <&kp RBRC>;
            key-positions = <28 29>;
            timeout-ms = <20>;
        };

        c7 {
            bindings = <&kp BSLH>;
            key-positions = <4 5>;
            timeout-ms = <20>;
        };

        c8 {
            bindings = <&kp PIPE>;
            key-positions = <14 15>;
            timeout-ms = <20>;
        };

        c9 {
            bindings = <&kp TAB>;
            key-positions = <18 17>;
            timeout-ms = <20>;
        };

        combo10 {
            bindings = <&mo 7>;
            key-positions = <11 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
                &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G  &kp H  &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMICOLON
                &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE  &mo 6  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                &kp LCTRL  &kp LGUI  &kp LALT  &lt 4 ESC  &lt 2 SPACE  &kp BACKSPACE  &lt 3 DEL  &lt 1 ENTER  &lt 5 TAB  &kp ENTER
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &trans  &trans  &kp LS(DQT)  &kp APOS  &trans  &trans  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(TILDE)  &trans
                &trans  &trans  &trans  &trans  &trans  &kp EQUAL  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp GRAVE
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(PLUS)  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(TILDE)
                &trans  &trans  &trans  &trans  &kp MINUS  &kp LS(MINUS)  &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            display-name = "NAVI";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp LGUI  &kp LALT  &kp LALT  &kp LSHFT  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp INSERT
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        function_layer {
            display-name = "FUNC";
            bindings = <
                &kp SCROLLLOCK  &kp F7  &kp F8  &kp F9  &kp F11  &trans  &trans  &trans  &trans  &trans
                &kp PRINTSCREEN  &kp F4  &kp F5  &kp F6  &kp F10  &trans  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LGUI
                &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        number_layer {
            display-name = "NUM";
            bindings = <
                &trans  &kp N7  &kp N8  &kp N9  &trans  &kp FSLH  &kp N7  &kp N8  &kp N9  &kp PLUS
                &trans  &kp N4  &kp N5  &kp N6  &kp NUMBER_0  &kp STAR  &kp N4  &kp N5  &kp N6  &kp KP_COMMA
                &trans  &kp N1  &kp N2  &kp N3  &trans  &trans  &trans  &kp MINUS  &kp N1  &kp N2  &kp N3  &kp KP_EQUAL
                &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMLOCK  &kp KP_NUMBER_0  &kp KP_NUMBER_0  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                           &trans    &mkp MB4  &mkp MB3  &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans     &trans      &trans    &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &kp LCTRL  &trans      &mkp MB2  &mkp MB1                      &trans    &trans
            >;

            display-name = "MOUSE";
        };

        BT {
            bindings = <
&kp F1  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                    &trans        &trans
            >;

            display-name = "BT";
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                  &trans  &trans
            >;
        };
    };
};
